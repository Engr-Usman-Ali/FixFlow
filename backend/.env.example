# FixFlow backend settings. Copy this file to ".env" in the same folder and fill it in.
# Every setting the API uses is read from here; nothing secret is written in the code.

# ---- App -------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173  # comma-separated frontend URLs allowed to call the API
MAX_REQUEST_BYTES=1000000           # largest accepted request body

# ---- Database (REQUIRED) ----------------------------------------------------
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://fixflow:fixflow@localhost:5432/fixflow
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Login tokens (SECRET_KEY REQUIRED, at least 32 characters) -------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Passwords: PBKDF2-HMAC-SHA256 + random salt per user ------------------
PASSWORD_HASH_ITERATIONS=600000
PASSWORD_SALT_BYTES=16
# Optional extra secret mixed into every hash. If you set it, never change or lose it,
# or nobody will be able to sign in. Generate like SECRET_KEY.
PASSWORD_PEPPER=
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5                # failed sign-ins before a temporary lock
LOGIN_LOCKOUT_MINUTES=15

# ---- Google Gemini (optional AI category/priority suggestions) -------------
# Get a key at https://aistudio.google.com/apikey . Leave empty to switch AI off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# ---- Service targets for new companies (hours until open work is overdue) --
DEFAULT_SLA_CRITICAL_HOURS=24
DEFAULT_SLA_HIGH_HOURS=72
DEFAULT_SLA_MEDIUM_HOURS=168
DEFAULT_SLA_LOW_HOURS=336

