# FixFlow frontend settings. Copy to ".env" in this folder if you need to change them.
# Nothing secret belongs here: everything in VITE_* is visible in the browser.

# Where the browser sends API calls. Keep "/api" in development (the dev server forwards it).
# In production set the full public API URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Development server only
VITE_DEV_PORT=5173
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Seconds before the app stops waiting for the server and shows an error
VITE_API_TIMEOUT_SECONDS=25
